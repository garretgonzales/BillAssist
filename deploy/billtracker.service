[Unit]
Description=Bill Tracker
After=network.target

[Service]
Type=simple
User=your-oslogin-username
WorkingDirectory=/home/your-oslogin-username/BillTracker
Environment=PORT=8080
Environment=OAUTH_REDIRECT_URI=https://your-domain.example/oauth2callback
ExecStart=/home/your-oslogin-username/BillTracker/venv/bin/gunicorn -w 2 -b 0.0.0.0:8080 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
